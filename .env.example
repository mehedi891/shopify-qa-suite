# Interactive mode needs NO configuration at all.
#   qa start → you log in → qa detect
# Everything below is only for unattended/CI runs.

# ---- Unattended runs only ----
# Google Sheets read + result write-back without a human
# GOOGLE_SERVICE_ACCOUNT_JSON=
# QA_SHEET_ID=
# QA_SHEET_TAB=Test Cases

# Resolves elements the free heuristics cannot, with no agent in the loop
# ANTHROPIC_API_KEY=

# Store details, if you would rather configure than detect
# SHOPIFY_STORE_DOMAIN=my-dev-store.myshopify.com
# SHOPIFY_APP_HANDLE=our-app
# SHOPIFY_APP_HOST=wise-lobster-amused.ngrok-free.app
# SHOPIFY_STOREFRONT_PASSWORD=

# ---- Optional ----
# SLACK_WEBHOOK_URL=

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=my-dev-store.myshopify.com
SHOPIFY_APP_HANDLE=our-app
# host of the app iframe src, used to locate the embedded frame
SHOPIFY_APP_HOST=our-app.example.com
SHOPIFY_STOREFRONT_PASSWORD=
# only used to prefill the `qa auth` login form; never stored
SHOPIFY_QA_EMAIL=

# ---- Google Sheets ----
QA_SHEET_ID=
QA_SHEET_TAB=Test Cases
# paste the whole service-account JSON on one line, OR set GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Planner ----
ANTHROPIC_API_KEY=

# ---- Optional ----
SLACK_WEBHOOK_URL=

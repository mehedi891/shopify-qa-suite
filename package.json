{
  "name": "shopify-qa-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated QA for our Shopify app: reads test cases from Google Sheets, runs them in a real browser across the embedded admin app and the storefront.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qa": "./dist/src/cli/index.js"
  },
  "scripts": {
    "qa": "tsx src/cli/index.ts",
    "auth": "tsx src/cli/index.ts auth",
    "validate": "tsx src/cli/index.ts validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.62.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehedi891/shopify-qa-suite.git"
  },
  "license": "UNLICENSED"
}